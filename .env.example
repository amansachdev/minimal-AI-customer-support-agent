# Local Docker Compose defaults. Copy to .env, then add your Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://mongo:27017/support-agent
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
